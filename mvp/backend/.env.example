# Copy this file to .env and fill in your key.
# The context engine (narrative synthesis) will not run without it —
# Wikipedia/Wikidata fact-gathering works fine without any key.
OPENAI_API_KEY=

# Optional overrides
OPENAI_MODEL=gpt-4o
CACHE_TTL_HOURS=168

# Family Ancestor Tool — set a fixed value so logins survive a server
# restart. Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
